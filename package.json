{
  "name": "office-agent-web",
  "version": "0.8.3",
  "private": true,
  "description": "Web-based Office document editor with pi agent integration",
  "type": "module",
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node server/index.mjs",
    "build": "cd client && npm run build",
    "verify": "node scripts/验证脚本.mjs",
    "map:fetch": "node scripts/fetch-boundaries.mjs",
    "map:prepare": "node scripts/prepare-map-data.mjs",
    "map:tiles": "node scripts/build-vector-tiles.mjs",
    "map:data": "npm run map:fetch && npm run map:prepare && npm run map:tiles"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "express": "^5.2.1",
    "typebox": "^1.3.10",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "geojson-vt": "^4.0.3",
    "pbf": "^5.1.2",
    "vt-pbf": "^3.1.3"
  }
}
