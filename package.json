{
  "name": "open-plan",
  "version": "0.10.0",
  "private": true,
  "description": "Web-based planning workbench with AI agent (规聚)",
  "type": "module",
  "scripts": {
    "start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"./启动规聚服务.ps1\"",
    "dev": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"./启动规聚服务.ps1\"",
    "build": "cd client && npm run build",
    "verify": "node scripts/验证脚本.mjs",
    "test:phase1": "node scripts/阶段一稳定性测试.mjs",
    "test:phase2": "node scripts/第二阶段记忆治理测试.mjs",
    "test:phase3": "node scripts/第三阶段项目与会话测试.mjs",
    "test:phase5-9": "node scripts/阶段五九测试.mjs",
    "test:phase6": "node scripts/阶段六运行时测试.mjs",
    "test:phase7": "node scripts/阶段七真实回归测试.mjs",
    "test:final": "node scripts/最后阶段模型调用回归测试.mjs",
    "test:closure": "node scripts/遗留十项测试.mjs",
    "map:fetch": "node scripts/fetch-boundaries.mjs",
    "map:prepare": "node scripts/prepare-map-data.mjs",
    "map:tiles": "node scripts/build-vector-tiles.mjs",
    "map:data": "npm run map:fetch && npm run map:prepare && npm run map:tiles",
    "map:m2-data": "node scripts/生成M2数据.mjs",
    "setup": "node scripts/install-officecli.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "docx": "^9.7.1",
    "express": "^5.2.1",
    "geojson-vt": "^4.0.2",
    "jszip": "^3.10.1",
    "typebox": "^1.3.10",
    "vt-pbf": "^3.1.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "geojson-vt": "^4.0.3",
    "pbf": "^5.1.2",
    "vt-pbf": "^3.1.3"
  }
}
